{
  "enabled": true,
  "name": "Auto Git Push",
  "description": "Automatically commits and pushes any file changes to GitHub after each agent edit",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "git add -A && git diff --cached --quiet || git commit -m \"Auto: update project files\" && git push origin main"
  }
}